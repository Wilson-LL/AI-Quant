# Cached market data — regenerable via research/data.py (deterministic given the
# same TWSE listing). NOTE: exact validated results depend on the 2026-07-06
# survivorship snapshot; future refetches use the then-current listed universe and
# may differ. Kept out of the repo to avoid committing bulk market data.
research/data_cache/

# Python build artifacts
__pycache__/
*.pyc

# Local virtualenv
.venv/

# Full-field incremental cache (bulk market data, regenerable)
research/data_cache_full/

# Model checkpoints (large, regenerable)
checkpoints/

# Bulk OOS score panels (regenerable from experiments; keep summary JSONs only)
reports/transformer_gpu/panels/
reports/transformer_gpu/logs/

# Personal financial data — never commit (my_holdings.example.csv IS committed)
my_holdings.csv
reports/user_holdings/
reports/user_actions/

# Manual console-tee logs of daily runs (untracked, write-only, no reader)
reports/paper_trading/daily_logs/

# v11 sweep logs (small but generated; summaries/queue JSONs are committed)
reports/continuous_research/v11_gpu_model_size_sweep/logs/

# v12 big-transformer research line — large generated artifacts
# (checkpoints/ above already covers checkpoints/v12_big_transformer/)
reports/transformer_gpu/v12_big_transformer/
reports/continuous_research/v12_big_transformer/logs/
reports/continuous_research/v12_big_transformer/**/*.csv.gz
*.pt
*.pth
*.ckpt

# v13 fixed-XL feature-rich research line (checkpoints/ covers its ckpts)
reports/transformer_gpu/v13_fixed_xl_feature_rich/
reports/continuous_research/v13_fixed_xl_feature_rich/logs/
reports/continuous_research/v13_fixed_xl_feature_rich/**/*.csv.gz

# v14 intraday playbook research — raw/derived intraday data and daily
# playbook outputs stay local (summary docs under continuous_research ARE
# committed on approval)
research/intraday_cache/
reports/intraday_playbook/
reports/continuous_research/v14_intraday_playbook/logs/

